# Environment — one of: dev, development, local, test, ci (anything else is treated as production)
# When ENV is not in the non-prod set, SECRET_KEY must be at least 32 chars and
# not equal to the dev default. The app refuses to boot otherwise.
ENV=dev

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/powerupcode

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_WEEKLY=price_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# Engine
ENGINE_MODULE=stub

# Email
# Dev: leave SMTP_HOST empty to log emails to console instead of sending.
#
# Prod option 1 — SendGrid (free tier: 100 emails/day):
#   1. Create account at https://sendgrid.com
#   2. Settings → Sender Authentication → verify your sending domain or single sender
#   3. Settings → API Keys → create key with "Mail Send" permission
#   4. Set SMTP_FROM_EMAIL to your verified sender address
#SMTP_HOST=smtp.sendgrid.net
#SMTP_PORT=587
#SMTP_USERNAME=apikey
#SMTP_PASSWORD=SG.your-api-key-here
#SMTP_FROM_EMAIL=noreply@powerupcode.com
#
# Prod option 2 — Mailgun (free tier: 1000 emails/month):
#   1. Create account at https://mailgun.com
#   2. Sending → Domains → add and verify your domain
#   3. Sending → Domain settings → SMTP credentials → copy username + password
#   4. Set SMTP_FROM_EMAIL to an address on your verified domain
#SMTP_HOST=smtp.mailgun.org
#SMTP_PORT=587
#SMTP_USERNAME=postmaster@mg.yourdomain.com
#SMTP_PASSWORD=your-mailgun-smtp-password
#SMTP_FROM_EMAIL=noreply@yourdomain.com
#
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=SG.your-api-key-here
SMTP_FROM_EMAIL=noreply@powerupcode.com
APP_URL=http://localhost:3001

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Sentry — leave SENTRY_DSN empty to disable error reporting entirely.
# Sign up at https://sentry.io and grab the DSN from your project settings.
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sentry (frontend) — same DSN as backend is fine.
# NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_ENV=development
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Analytics — PostHog. Leave keys empty in dev/test to disable tracking
# entirely. Sign up at https://posthog.com (free tier covers 1M events/mo)
# and paste the project API key. Use the SAME project for both client and
# server so funnels can join client events (register, attempt) with server
# events (subscription.activated, attempt.first_pass) on distinct_id.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://us.posthog.com
