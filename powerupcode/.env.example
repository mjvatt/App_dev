# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/powerupcode

# Auth
SECRET_KEY=change-me-in-production

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_WEEKLY=price_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# Engine
ENGINE_MODULE=stub

# Email
# Dev: leave SMTP_HOST empty to log emails to console instead of sending.
# Prod (SendGrid):
#   1. Create a free SendGrid account at https://sendgrid.com
#   2. Settings → Sender Authentication → verify your sending domain or a single sender address
#   3. Settings → API Keys → create a key with "Mail Send" permission
#   4. Set SMTP_FROM_EMAIL to the verified sender address
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=SG.your-api-key-here
SMTP_FROM_EMAIL=noreply@powerupcode.com
APP_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
